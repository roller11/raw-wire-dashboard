    /**
     * Get recent investigations
     *
     * @return array
     */
    private function get_recent_investigations()
    {
        global $wpdb;

        $table_name = $wpdb->prefix . 'rawwire_investigations';

        // Check if table exists
        if ($wpdb->get_var("SHOW TABLES LIKE '$table_name'") !== $table_name) {
            return $this->get_sample_investigations();
        }

        $results = $wpdb->get_results(
            "SELECT * FROM $table_name ORDER BY created_at DESC LIMIT 10",
            ARRAY_A
        );

        if (empty($results)) {
            return $this->get_sample_investigations();
        }

        return array_map(function ($row) {
            return array(
                'id' => $row['id'],
                'company' => $row['company_name'] ?? 'Unknown',
                'type' => $row['company_type'] ?? 'General Contractor',
                'project' => $row['project_name'] ?? 'Active Project',
                'value' => $row['project_value'] ?? 0,
                'score' => $row['lead_score'] ?? rand(40, 95),
            );
        }, $results);
    }

