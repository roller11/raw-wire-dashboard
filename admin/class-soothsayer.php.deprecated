defined('ABSPATH') || exit;

/**
 * Class RawWire_Soothsayer
 *
 * Renders the intelligence war room interface with:
 * - Animated workflow pipeline visualization
 * - Real-time intelligence data stream
 * - Decision maker action buttons
 * - Investigation status overview
 */
class RawWire_Soothsayer
{

    /**
     * Instance
     *
     * @var RawWire_Soothsayer
     */
    private static $instance = null;

    /**
     * Get singleton instance
     *
     * @return RawWire_Soothsayer
     */
    public static function get_instance()
    {
        if (null === self::$instance) {
            self::$instance = new self();
        }
        return self::$instance;
    }

    /**
     * Constructor
     */
    private function __construct()
    {
        add_action('wp_ajax_rawwire_launch_workflow', array($this, 'ajax_launch_workflow'));
        add_action('wp_ajax_rawwire_get_intel_stream', array($this, 'ajax_get_intel_stream'));
        add_action('wp_ajax_rawwire_executive_action', array($this, 'ajax_executive_action'));
    }

    /**
     * Render the soothsayer page
     */
    public function render()
    {
        $this->enqueue_assets();
        $investigations = $this->get_recent_investigations();
        $stats = $this->get_intelligence_stats();
?>
        <div class="rawwire-dashboard rawwire-soothsayer">
            <?php $this->render_hero(); ?>
            <?php $this->render_workflow_pipeline(); ?>

            <div class="rawwire-soothsayer-grid">
                <div class="rawwire-soothsayer-main">
                    <?php $this->render_intel_stream(); ?>
                    <?php $this->render_decision_matrix($investigations); ?>
                </div>
                <div class="rawwire-soothsayer-sidebar">
                    <?php $this->render_quick_stats($stats); ?>
                    <?php $this->render_action_hub(); ?>
                </div>
            </div>
        </div>
    <?php
    }

    /**
     * Enqueue page assets
     */
    private function enqueue_assets()
    {
        $plugin_url = plugin_dir_url(__FILE__) . '../';
        $version = defined('RAWWIRE_DASHBOARD_VERSION') ? RAWWIRE_DASHBOARD_VERSION : '1.0.30';

        wp_enqueue_style(
            'rawwire-soothsayer',
            $plugin_url . 'css/soothsayer.css',
            array(),
            $version
        );

        wp_enqueue_script(
            'rawwire-soothsayer',
            $plugin_url . 'js/soothsayer.js',
            array('jquery'),
            $version,
            true
        );

        wp_localize_script('rawwire-soothsayer', 'soothsayerData', array(
            'ajaxUrl' => admin_url('admin-ajax.php'),
            'nonce' => wp_create_nonce('rawwire_soothsayer'),
            'streamEndpoint' => rest_url('rawwire/v1/intel-stream'),
        ));
    }

