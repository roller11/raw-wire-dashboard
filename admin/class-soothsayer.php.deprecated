            array('id' => 2, 'company' => 'Webcor Builders', 'type' => 'General Contractor', 'project' => 'SF Medical Center', 'value' => 280000000, 'score' => 87),
            array('id' => 3, 'company' => 'DPR Construction', 'type' => 'General Contractor', 'project' => 'Data Center Expansion', 'value' => 175000000, 'score' => 84),
            array('id' => 4, 'company' => 'Swinerton', 'type' => 'General Contractor', 'project' => 'Mixed-Use Development', 'value' => 120000000, 'score' => 78),
            array('id' => 5, 'company' => 'Clark Construction', 'type' => 'General Contractor', 'project' => 'Government Complex', 'value' => 320000000, 'score' => 75),
        );
    }

    /**
     * Get intelligence stats
     *
     * @return array
     */
    private function get_intelligence_stats()
    {
        global $wpdb;

        // Try to get real stats, fallback to demo
        $table_name = $wpdb->prefix . 'rawwire_investigations';

        if ($wpdb->get_var("SHOW TABLES LIKE '$table_name'") !== $table_name) {
            return array(
                'total_projects' => 47,
                'total_companies' => 23,
                'total_value' => 2450000000,
                'hot_leads' => 8,
            );
        }

        return array(
            'total_projects' => (int) $wpdb->get_var("SELECT COUNT(*) FROM $table_name"),
            'total_companies' => (int) $wpdb->get_var("SELECT COUNT(DISTINCT company_name) FROM $table_name"),
            'total_value' => (float) $wpdb->get_var("SELECT SUM(project_value) FROM $table_name") ?: 0,
            'hot_leads' => (int) $wpdb->get_var("SELECT COUNT(*) FROM $table_name WHERE lead_score >= 80"),
        );
    }

    /**
     * Format currency for display
     *
     * @param float $value
     * @return string
     */
    private function format_currency($value)
    {
        if ($value >= 1000000000) {
            return round($value / 1000000000, 1) . 'B';
        }
        if ($value >= 1000000) {
            return round($value / 1000000, 1) . 'M';
        }
        if ($value >= 1000) {
            return round($value / 1000, 1) . 'K';
        }
        return number_format($value);
    }

    /**
     * AJAX: Launch workflow
     */
    public function ajax_launch_workflow()
    {
        check_ajax_referer('rawwire_soothsayer', 'nonce');

        if (!current_user_can('manage_options')) {
            wp_send_json_error('Insufficient permissions');
        }

        // Simulate workflow launch
        $stages = array('scan', 'harvest', 'process', 'classify', 'deploy');

        wp_send_json_success(array(
            'message' => 'Intelligence sweep initiated',
            'stages' => $stages,
            'estimated_time' => 45,
        ));
    }

    /**
     * AJAX: Get intel stream data
     */
    public function ajax_get_intel_stream()
    {
        check_ajax_referer('rawwire_soothsayer', 'nonce');

        $stream_data = $this->generate_stream_entries();

        wp_send_json_success(array(
            'entries' => $stream_data,
            'total' => count($stream_data),
        ));
    }

    /**
     * AJAX: Executive action dispatch
     */
    public function ajax_executive_action()
    {
        check_ajax_referer('rawwire_soothsayer', 'nonce');

        if (!current_user_can('manage_options')) {
            wp_send_json_error('Insufficient permissions');
        }

        $action = sanitize_text_field($_POST['exec_action'] ?? '');
        $target_id = intval($_POST['target_id'] ?? 0);

        $actions = array(
            'targeted_email' => 'Email campaign queued',
            'industry_report' => 'Report generation started',
            'corporate_intel' => 'Deep analysis initiated',
            'project_tracker' => 'Tracker updated',
            'contact_finder' => 'Contact search started',
            'schedule_followup' => 'Follow-ups scheduled',
        );

        if (!isset($actions[$action])) {
            wp_send_json_error('Unknown action');
        }

        wp_send_json_success(array(
            'message' => $actions[$action],
            'action' => $action,
            'timestamp' => current_time('mysql'),
        ));
    }

    /**
     * Generate stream entries for demo
     *
     * @return array
     */
    private function generate_stream_entries()
    {
        $types = array(
            array('type' => 'scan', 'icon' => 'search', 'messages' => array(
                'Detected new permit filing',
                'Construction signal identified',
                'Project announcement captured',
            )),
            array('type' => 'harvest', 'icon' => 'download', 'messages' => array(
                'Company profile extracted',
                'Project details collected',
                'Contact information gathered',
            )),
            array('type' => 'process', 'icon' => 'admin-generic', 'messages' => array(
                'AI analysis complete',
                'Pattern match identified',
                'Industry correlation found',
            )),
            array('type' => 'classify', 'icon' => 'chart-bar', 'messages' => array(
                'Lead scored: HIGH priority',
                'Target classified: ACTIVE',
                'Opportunity rating: EXCELLENT',
            )),
        );

        $entries = array();
        for ($i = 0; $i < 5; $i++) {
            $category = $types[array_rand($types)];
            $entries[] = array(
                'id' => uniqid(),
                'type' => $category['type'],
                'icon' => $category['icon'],
                'message' => $category['messages'][array_rand($category['messages'])],
                'timestamp' => date('H:i:s', strtotime("-{$i} minutes")),
            );
        }

        return $entries;
    }
}
