<?php

/**
 * Soothsayer - Intelligence War Room
 *
 * High-tech dashboard for intelligence collection and decision support.
 * Features animated workflow visualization and real-time data streaming.
 *
 * @package RawWire_Dashboard
 * @since 1.0.30
